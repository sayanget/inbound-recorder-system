# 复制为 neon_sync.env 后填写（neon_sync.env 已在 .gitignore，勿提交）
# 一键配置: setup_neon_auto_sync.bat
# 自动同步入口（监听 / 开机 / 每日）: neon_auto_sync.bat

# ========== 必填：Neon 连接串 ==========
# 从 Neon 控制台「Connection string」复制整段 URI（不要带 psql 前缀）
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# 若含 &channel_binding=require 可保留，同步脚本会自动处理。
# 若同时配置了下面的 DATABASE_URL_PRODUCTION / SANDBOX：请删掉本行 DATABASE_URL，或把它设成「主库」连接串；
# 否则 DATABASE_URL 会优先于 DATABASE_URL_PRODUCTION，数据可能同步到测试库而主库仍为空。
DATABASE_URL=

# ========== 多目标同步（sync_neon_targets.bat）==========
# 主库 production 与 测试库 sandbox 分开配置；不要带 psql 前缀。
# DATABASE_URL_PRODUCTION=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_SANDBOX=postgresql://USER:PASSWORD@ep-yyyy-pooler.region.aws.neon.tech/neondb?sslmode=require

# ========== 自动同步到「这个」数据库 ==========
# 监听/夜间任务/开机启动 均使用 effective_database_url：
#   优先 DATABASE_URL；若为空则用 DATABASE_URL_PRODUCTION。
# 只同步主库时：要么只填 DATABASE_URL_PRODUCTION，要么 DATABASE_URL 填主库（勿填测试库）。
# 参数说明见下方 NEON_SYNC_*。

# ========== 可选 ==========
# 本地 SQLite 文件（默认项目根目录 inbound.db）
# DATABASE_PATH=D:\project\inbound_python_source\inbound.db

# 最后一次写入后等待多少秒再同步（避免连续写入时反复全量同步）
NEON_SYNC_DEBOUNCE_SECONDS=90

# 两次同步之间最小间隔秒数（默认 30），进一步避免高频重复全量同步
NEON_SYNC_MIN_INTERVAL_SECONDS=30

# 设为 0 可临时关闭监听脚本（需重启监听进程生效）
NEON_SYNC_ENABLED=1

# 默认同步为先写临时 schema 再切换 public（失败不丢线上数据）。仅当必须恢复旧行为时设为 1：
# SQLITE_SYNC_DIRECT_PUBLIC=1
