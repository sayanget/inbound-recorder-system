# Copy to ".env" in the project root and fill in before running Docker or production.
# Do not commit .env.

# Flask session signing — use a long random string (e.g. openssl rand -hex 32)
SECRET_KEY=

# Optional: fixed password for first-time "admin" user on empty DB.
# If unset, a random password is printed once to stdout at first init.
INITIAL_ADMIN_PASSWORD=

# Optional: seed gofo_admin_token in system_config on new DB (otherwise empty; set in app/DB later)
GOFO_ADMIN_TOKEN=

# app_monitor.py — required for POST /restart /stop /start (GET /status works without it)
MONITOR_SECRET=

# --- Docker / docker-compose ---
# compose 会把 SQLite 放在宿主机 ./data/inbound.db（需先有目录或首次自动创建）
# DATABASE_PATH=/app/data/inbound.db
# 使用 PostgreSQL（Neon 等）时设置 DATABASE_URL，不要与仅 SQLite 的 DATABASE_PATH 混用逻辑冲突：
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# --- 本地 SQLite -> Neon 自动同步 ---
# 推荐：复制 neon_sync.env.example 为 neon_sync.env（git 忽略），专放同步用 DATABASE_URL
# 一键安装依赖与模板: 双击 setup_neon_auto_sync.bat
# 启动监听: run_watch_neon_sync.bat ； 开机自启: install_neon_watch_startup.ps1
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# NEON_SYNC_DEBOUNCE_SECONDS=90
# NEON_SYNC_MIN_INTERVAL_SECONDS=30
# NEON_SYNC_ENABLED=1
