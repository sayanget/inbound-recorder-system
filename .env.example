# Copy to ".env" in the project root and fill in before running Docker or production.
# Do not commit .env.

# Flask session signing — use a long random string (e.g. openssl rand -hex 32)
SECRET_KEY=

# Optional: fixed password for first-time "admin" user on empty DB.
# If unset, a random password is printed once to stdout at first init.
INITIAL_ADMIN_PASSWORD=

# Optional: seed gofo_admin_token in system_config on new DB (otherwise empty; set in app/DB later)
GOFO_ADMIN_TOKEN=

# app_monitor.py — required for POST /restart /stop /start (GET /status works without it)
MONITOR_SECRET=
# Optional: monitor bind (defaults 0.0.0.0:8081). On Windows, 8080–8156 may be in Hyper-V/WSL
# "excluded" ranges (bind → WinError 10013); use e.g. PORT=8780 MONITOR_PORT=18081
# MONITOR_HOST=0.0.0.0
# MONITOR_PORT=18081
# PORT=8780
# APP_PORT=8780

# --- Docker / docker-compose ---
# compose 会把 SQLite 放在宿主机 ./data/inbound.db（需先有目录或首次自动创建）
# DATABASE_PATH=/app/data/inbound.db
# 使用 PostgreSQL（Neon 等）时设置 DATABASE_URL，不要与仅 SQLite 的 DATABASE_PATH 混用逻辑冲突：
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# --- 本地 SQLite -> Neon 自动同步 ---
# 推荐：复制 neon_sync.env.example 为 neon_sync.env（git 忽略），专放同步用 DATABASE_URL
# 一键安装依赖与模板: 双击 setup_neon_auto_sync.bat
# 启动监听: run_watch_neon_sync.bat ； 开机自启: install_neon_watch_startup.ps1
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# NEON_SYNC_DEBOUNCE_SECONDS=90
# NEON_SYNC_MIN_INTERVAL_SECONDS=30
# NEON_SYNC_ENABLED=1

# --- GitHub 遥测（可选）---
# TELEMETRY_GITHUB_ENABLE=1
# GITHUB_TELEMETRY_REPO=owner/repo
# GITHUB_TELEMETRY_ISSUE=1
# GITHUB_TELEMETRY_TOKEN=ghp_xxx
# 白名单：命中则不上报（逗号分隔）。运行: python telemetry_github.py show 查看本机值
# TELEMETRY_WHITELIST_FINGERPRINTS=64位十六进制SHA256
# TELEMETRY_WHITELIST_MACHINE_IDS=Windows-MachineGuid 或 Linux-machine-id
# TELEMETRY_WHITELIST_IPS=127.0.0.1,192.168.*.*,10.*.*.*
# TELEMETRY_WHITELIST_HOSTNAMES=my-pc,authorized-*
# 反向代理后取真实 IP（Render 等）：TRUST_PROXY_HEADERS=1
# 双通道：自建 HTTPS 接收端，验签 HMAC 后写入数据库（见 telemetry_github._post_signed_backup）
# TELEMETRY_BACKUP_URL=https://your-server.example.com/telemetry-ingest
# TELEMETRY_BACKUP_SECRET=长随机串与接收端一致

# --- 许可证在线校验（代码已接入；默认不强制）---
# 现阶段：勿设置 LICENSE_ENFORCE，业务不拦截。需要时可先配 URL+TOKEN 做联调，仍可不强制。
# 上线强制前三步：① 部署 license_server（见 license_server/README.md）② 业务 .env 填 LICENSE_SERVER_URL、LICENSE_DEVICE_TOKEN（激活见仓库说明）③ 访问 GET /api/license_status，确认 ready_for_enforce=true
# 第四步：设置 LICENSE_ENFORCE=1，重启业务进程。
# LICENSE_SERVER_URL=https://你的许可服务域名或内网:8088
# LICENSE_DEVICE_TOKEN=          # 可选；未设时可用管理后台激活写入 system_config
# # LICENSE_ENFORCE=1
# LICENSE_VERIFY_CACHE_SECONDS=300   # 0=每次请求都校验；吊销后生效速度与此相关
# LICENSE_GRACE_HOURS=24           # 仅许可服务连不上时宽限；吊销默认不走宽限
# LICENSE_NO_GRACE_ERRORS=revoked,device_revoked,expired,invalid_token
# LICENSE_GRACE_ON_REVOKE=0        # 1=吊销后也允许宽限（旧行为，不推荐）
# 吊销尽快锁站示例：LICENSE_ENFORCE=1 + CACHE=60 + GRACE_HOURS=0
# FEISHU_CNO_NARROWBELT_REPLACE_OPERATING_DAY=1   # 窄带飞书同步默认整批重写运营日（0=仅增量有量整点）
# 联调/验收：GET http://<业务>:<端口>/api/license_status（看 enforced / configured / ok / ready_for_enforce）
# 许可服务管理页需：LICENSE_ADMIN_KEY、可选 LICENSE_WEB_SECRET、LICENSE_SESSION_DAYS=90
# LICENSE_WEB_SECRET=
# LICENSE_SESSION_DAYS=90
# 仅 HTTPS 部署许可管理页时：LICENSE_SESSION_SECURE=1
